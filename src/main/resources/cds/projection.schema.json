{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alxarafe.org/arp/drafts/cds/v1/projection.schema.json",
  "title": "ARP-CDS-001 proposed projection descriptor (not published)",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "source",
    "fields",
    "operations"
  ],
  "properties": {
    "apiVersion": {
      "const": "arp.projection/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "entity"
          ],
          "properties": {
            "entity": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "projection"
          ],
          "properties": {
            "projection": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "LIST",
          "GET",
          "CREATE",
          "UPDATE",
          "DELETE"
        ]
      }
    }
  },
  "additionalProperties": false
}
