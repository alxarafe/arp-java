{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alxarafe.org/arp/drafts/cds/v1/physical.schema.json",
  "title": "ARP-CDS-001 unified proposed physical descriptor (not published)",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "kind",
    "source",
    "columns"
  ],
  "properties": {
    "apiVersion": {
      "const": "arp.physical/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "table",
        "view"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "dialect",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "nativeType"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "nativeType": {
            "type": "string",
            "minLength": 1
          },
          "scalarType": {
            "enum": [
              "BOOLEAN",
              "STRING",
              "TEXT",
              "INT8",
              "UINT8",
              "INT16",
              "UINT16",
              "INT32",
              "UINT32",
              "INT64",
              "DECIMAL",
              "UUID",
              "DATE",
              "TIME",
              "DATETIME",
              "ENUM",
              "BINARY"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "identity": {
            "type": "boolean"
          },
          "generated": {
            "type": "boolean"
          },
          "integerRange": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "$ref": "#/$defs/exactInteger"
              },
              "maximum": {
                "$ref": "#/$defs/exactInteger"
              }
            },
            "minProperties": 1
          },
          "characterLength": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "unit": {
                "enum": [
                  "CHARACTERS",
                  "BYTES"
                ]
              }
            }
          },
          "decimalGeometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "precision",
              "scale"
            ],
            "properties": {
              "precision": {
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "primaryKey": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "columns",
          "unique"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          },
          "unique": {
            "type": "boolean"
          }
        }
      }
    },
    "foreignKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "columns",
          "target"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "columns"
            ],
            "properties": {
              "catalog": {
                "$ref": "#/$defs/name"
              },
              "schema": {
                "$ref": "#/$defs/name"
              },
              "table": {
                "$ref": "#/$defs/name"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "exactInteger": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    }
  }
}
