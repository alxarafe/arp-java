{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alxarafe.org/arp/drafts/cds/v1/logical.schema.json",
  "title": "ARP-CDS-001 proposed logical descriptor (not published)",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "physical",
    "fields"
  ],
  "properties": {
    "apiVersion": {
      "const": "arp.logical/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "physical": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "dictionary": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
            "maxLength": 128
          },
          "constraints": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "maximum": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "exclusiveMinimum": {
                "type": "boolean"
              },
              "exclusiveMaximum": {
                "type": "boolean"
              },
              "multipleOf": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "minimumLength": {
                "type": "integer",
                "minimum": 0
              },
              "maximumLength": {
                "type": "integer",
                "minimum": 0
              },
              "precision": {
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "type": "integer",
                "minimum": 0
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
